<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MoLink" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:colorBackground">@color/canvas</item>
    </style>

    <style name="Widget.MoLink.Button" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@color/brand</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.MoLink.ToolbarButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>
</resources>
