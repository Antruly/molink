<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/text_host"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/button_keyboard"
            style="@style/Widget.MoLink.ToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/action_keyboard" />

        <Button
            android:id="@+id/button_reload"
            style="@style/Widget.MoLink.ToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/action_reload" />

        <Button
            android:id="@+id/button_host"
            style="@style/Widget.MoLink.ToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/action_host" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/session_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000" />
</LinearLayout>
