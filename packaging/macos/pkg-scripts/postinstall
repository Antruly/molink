#!/bin/sh
set -e
HERE=$(cd "$(dirname "$0")" && pwd)
. "$HERE/molink-user.sh"
create_user
prepare_dirs
if [ ! -f /usr/local/etc/molink-server/config.json ]; then
  install -m 0644 /usr/local/etc/molink-server/config.json.example \
    /usr/local/etc/molink-server/config.json
fi
bootstrap_daemon
exit 0
