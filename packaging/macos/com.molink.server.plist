<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.molink.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/molink-server/bin/molink-server</string>
    <string>--config</string>
    <string>/usr/local/etc/molink-server/config.json</string>
  </array>
  <key>UserName</key>
  <string>_molink</string>
  <key>GroupName</key>
  <string>_molink</string>
  <key>WorkingDirectory</key>
  <string>/usr/local/var/molink-server</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/molink-server/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/molink-server/launchd.log</string>
</dict>
</plist>
